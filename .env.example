ECG_DATA_ROOT=./data
ECG_ARTIFACTS_ROOT=./artifacts

# --- Weights & Biases ----------------------------------------------------------
WANDB_API_KEY=
WANDB_ENTITY=

# --- Misc ------------------------------------------------------------------------
PYTHONHASHSEED=42
